# Firebase 프로젝트 설정값 (Firebase Console → 프로젝트 설정 → 내 앱 → 구성)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firestore 안의 데이터 폴더 이름 — 영문·숫자·하이픈만 사용
# 본인 행사 고유 ID로 변경하세요 (예: hometown-church-2027, summer-retreat-2027)
VITE_FIREBASE_EVENT_ID=my-retreat-2027
