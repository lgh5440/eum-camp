{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/apply",  "destination": "/share-apply.html" },
      { "source": "/system", "destination": "/share-system.html" },
      { "source": "**",      "destination": "/index.html" }
    ]
  }
}
