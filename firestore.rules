rules_version = '2';

// 보안 모델 (무료 요금제 / 익명 인증 기준)
//   1) 인증된 사용자만 (request.auth != null) — Firebase Auth 통과 필수
//   2) 화이트리스트 stateDoc만 허용 — 알 수 없는 키 차단
//   3) retreatId는 자유 — 다른 교회가 fork 후 자기 ID 써도 작동
//   4) authCreds(관리자/위원 비밀번호 해시)는 화이트리스트에서 제외 = 클라이언트 접근 전면 차단
//   5) demoReset — 데모 배포본의 "새벽 4시 초기화" 표식 문서. 데이터가 아니라 잠금/표식용이며,
//      데모가 아닌 배포본에서는 클라이언트가 아예 건드리지 않는다(VITE_DEMO_MODE 기본 OFF).
//   6) 그 외 모든 경로 차단
//
// ⚠ 이 규칙만으로 막지 못하는 것 (구조적 한계 — 요금제·아키텍처 결정 필요):
//   • 익명 인증(signInAnonymously)을 쓰는 한, 정상 운영진과 외부 공격자는 규칙상
//     구별 불가하다(둘 다 request.auth != null). 따라서 participants 등 운영 문서의
//     "외부인 읽기/쓰기 차단"은 규칙만으로는 불가능하다.
//   • 근본 해결(택1):
//       (A) 클라우드 동기화 OFF — .env 미설정(단일 기기 localStorage) 또는 Firebase
//           콘솔에서 익명 로그인 공급자 비활성화. 유출 위험 0, 다기기·온라인신청 불가.
//       (B) Cloud Functions 서버 인증(custom claim) 도입 — Blaze(유료) 필요.
//           (functions/ 등 서버 인증 작업본이 별도 보관 중, 채택 시 이 규칙도 교체)
//   • authCreds 는 위 한계와 무관하게 (4)로 이미 클라이언트에서 완전히 차단된다.

service cloud.firestore {
  match /databases/{database}/documents {
    match /retreats/{retreatId}/state/{stateDoc} {
      allow read, write: if request.auth != null
        && stateDoc in [
          'participants',
          'checklistStatus',
          'checklistItems',
          'checkIn',
          'churchConfig',
          'churchConfirm',
          'groupMeta',
          'roomConfig',
          'noticeItems',
          'noticeTargetConfig',
          'safetyItems',
          'scheduleCategories',
          'scheduleItems',
          'applicationQueue',
          'changeLog',
          'dailyWord',
          'eventConfig',
          'menuVisibility',
          'demoReset'
        ];
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
